#!/usr/bin/env bash
# Set CODEBOOMER_PATH to the plugin directory, or default to this script's directory
# Extra args pass through to nvim — e.g. launch straight into a PR review:
#   CODEBOOMER_PATH=$PWD ./test-codeboomer -c 'Codeboomer Review [pr]'
CODEBOOMER_PATH="${CODEBOOMER_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

nvim \
	--cmd "lua vim.opt.runtimepath:prepend('$CODEBOOMER_PATH')" \
	--cmd "lua vim.g.mapleader = ' '" \
	--cmd "lua vim.keymap.set({'n', 'x'}, '<Space>', '<Nop>')" \
	--cmd "lua require('codeboomer').setup({debug=false,keybindings={send_prompt='<leader>cs', send_last_prompt='<leader>cl', send_selection='<leader>cr', flush_with_directive='<leader>cd', pane='<leader>cp', launch_reviewer='<leader>cA', launch_process='<leader>cT', pane_toggle='<leader>ct', sidebar_toggle='<leader>cb', reset_session='<leader>cS', review='<leader>cR', post_review='<leader>cP', pull_review='<leader>cL', annotate='<leader>ca'}, prompting={review_agents={{label='claude', argv={'nix','run','github:numtide/llm-agents.nix#claude-code','--','--dangerously-skip-permissions'}}, {label='pi', argv={'nix','run','github:numtide/llm-agents.nix#pi','--'}}}, launch_processes={{label='pi', argv={'nix','run','github:numtide/llm-agents.nix#pi','--'}}, {label='claude', argv={'nix','run','github:numtide/llm-agents.nix#claude-code','--','--dangerously-skip-permissions'}}}}})" \
	"$@"
