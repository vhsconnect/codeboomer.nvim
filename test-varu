#!/usr/bin/env bash
# Set VARUBREV_PATH to the plugin directory, or default to this script's directory
#VARUBREV_PATH="${VARUBREV_PATH:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

nvim \
  --cmd "lua vim.opt.runtimepath:prepend('$VARUBREV_PATH')" \
  --cmd "lua vim.g.mapleader = ' '" \
  --cmd "lua vim.keymap.set({'n', 'x'}, '<Space>', '<Nop>')" \
  --cmd "lua require('varubrev').setup({keybindings={send='<leader>cs', send_visual='<leader>cs', send_visualOO='<leader>cc', send_with_directive='<leader>cd', pane='<leader>cp', annotate='<leader>ca'}})" \
  "$@"
